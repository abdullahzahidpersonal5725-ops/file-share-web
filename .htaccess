RewriteEngine On

# Pass Authorization header to PHP
SetEnvIf Authorization "(.*)" HTTP_AUTHORIZATION=$1
RewriteCond %{HTTP:Authorization} ^(.*)
RewriteRule .* - [e=HTTP_AUTHORIZATION:%1]
# Protect sensitive data
RewriteRule ^(users\.json|sessions\.json|smtp-config\.json|server\.log|server\.js|package\.json|package-lock\.json)$ - [F,L]
RewriteRule ^(uploads|shared)/.* - [F,L]

# API Routing
RewriteRule ^api/(.*)$ api/index.php?route=$1 [QSA,L]

# Frontend explicit routes
RewriteRule ^login$ public/login.html [L]
RewriteRule ^app$ public/index.html [L]
RewriteRule ^admin$ public/admin.html [L]
RewriteRule ^forgot-password$ public/forgot-password.html [L]
RewriteRule ^setup-2fa$ public/setup-2fa.html [L]
RewriteRule ^documents$ public/documents.html [L]
RewriteRule ^documents/trash$ public/documents.html [L]
RewriteRule ^settings$ public/settings.html [L]
RewriteRule ^share/([a-zA-Z0-9-]+)$ public/share.html [L]

# Serve from public if it exists
RewriteCond %{DOCUMENT_ROOT}/public/$1 -f [OR]
RewriteCond %{DOCUMENT_ROOT}/public/$1 -d
RewriteRule ^(.*)$ public/$1 [L]

# Default to index.html
RewriteRule ^$ public/index.html [L]
