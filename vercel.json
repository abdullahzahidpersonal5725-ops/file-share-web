{
  "routes": [
    {
      "src": "/api/(.*)",
      "dest": "/server.js"
    },
    {
      "src": "/auth/(.*)",
      "dest": "/server.js"
    },
    {
      "src": "/app",
      "dest": "/index.html"
    },
    {
      "src": "/files",
      "dest": "/index.html"
    },
    {
      "src": "/setup-2fa",
      "dest": "/setup-2fa.html"
    },
    {
      "src": "/forgot-password",
      "dest": "/forgot-password.html"
    },
    {
      "src": "/share",
      "dest": "/share.html"
    },
    {
      "src": "/login",
      "dest": "/login.html"
    },
    {
      "src": "/landing",
      "dest": "/landing.html"
    },
    {
      "src": "/admin",
      "dest": "/admin.html"
    },
    {
      "src": "/documents",
      "dest": "/documents.html"
    },
    {
      "src": "/settings",
      "dest": "/settings.html"
    },
    {
      "src": "/",
      "dest": "/index.html"
    }
  ]
}
